#!/usr/bin/env bash

set -e

TOOL_SOURCE="${BASH_SOURCE[0]}"
while [ -h "$TOOL_SOURCE" ] ; do TOOL_SOURCE="$(readlink "$TOOL_SOURCE")"; done
SDLC_DIR="$( cd -P "$( dirname "$TOOL_SOURCE" )" && pwd )"
PRJ_HOME="$( cd -P "$( dirname "$SDLC_DIR" )" && pwd )"

source "${SDLC_DIR}/config"
DIST_DIR="${PRJ_HOME}/${DIST_DIR}"

if [[ -d "$DIST_DIR" ]]; then rm -r "$DIST_DIR"; fi
mkdir -p "$DIST_DIR"

cd "${PRJ_HOME}"

ldflags="$(go_ldflags)"
echo "building ${REPO_NAME} ${APP_VERSION}"

platforms="linux/amd64 linux/arm64"

for dir in $(find "${PRJ_HOME}/cmd" -mindepth 1 -maxdepth 1 -type d); do
  app_name=$(basename "$dir")
  for platform in $platforms; do
    goos="${platform%/*}"
    goarch="${platform#*/}"
    name="${app_name}-${APP_VERSION}_${goos}_${goarch}"
    echo "=== ${name}"
    GOOS="$goos" GOARCH="$goarch" go build "${GO_BUILD_FLAGS[@]}" -ldflags "$ldflags" \
      -o "${DIST_DIR}/${name}/${app_name}" "${MODULE}/cmd/${app_name}"
    tar -C "${DIST_DIR}" -czf "${DIST_DIR}/${name}.tar.gz" "$name"
    rm -r "${DIST_DIR:?}/${name}"
  done
done

cd "$DIST_DIR"
if command -v sha256sum >/dev/null; then
  sha256sum ./*.tar.gz > SHA256SUMS
elif command -v shasum >/dev/null; then
  shasum -a 256 ./*.tar.gz > SHA256SUMS
else
  echo "neither sha256sum nor shasum found: SHA256SUMS not written"
  exit 1
fi
