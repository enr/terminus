#!/usr/bin/env bash

set -e

TOOL_SOURCE="${BASH_SOURCE[0]}"
while [ -h "$TOOL_SOURCE" ] ; do TOOL_SOURCE="$(readlink "$TOOL_SOURCE")"; done
SDLC_DIR="$( cd -P "$( dirname "$TOOL_SOURCE" )" && pwd )"
PRJ_HOME="$( cd -P "$( dirname "$SDLC_DIR" )" && pwd )"

source "${SDLC_DIR}/config"

cd "${PRJ_HOME}"

echo "--- gofmt"
unformatted="$(gofmt -l cmd internal)"
[[ -z "$unformatted" ]] || {
  echo "files not formatted:"
  echo "$unformatted"
  exit 1
}

echo "--- go mod tidy"
go mod tidy -diff

echo "--- go vet"
go vet ./...

if command -v staticcheck >/dev/null; then
  echo "--- staticcheck"
  staticcheck ./...
else
  echo "--- staticcheck not installed, skipped (go install honnef.co/go/tools/cmd/staticcheck@latest)"
fi

echo "--- go test"
CGO_ENABLED=1 go test -race -cover ./... 2>/dev/null || go test -cover ./...

echo "--- static build"
"${SDLC_DIR}/build"
for bin in "${PRJ_HOME}"/bin/*; do
  file "$bin" | grep -q "statically linked" || {
    echo "not a static binary: $(file "$bin")"
    exit 1
  }
done
echo "ok"
