REPO_HOST='github.com'
REPO_OWNER='enr'
REPO_NAME='terminus'
DIST_DIR='dist'

APP_VERSION='0.2.0-dev' # APP_VERSION_AUTOLINE this line is automatically managed

MODULE="${REPO_HOST}/${REPO_OWNER}/${REPO_NAME}"

# Static binaries: no cgo, no dependency on the build machine paths.
export CGO_ENABLED=0
GO_BUILD_FLAGS=(-trimpath)

# go_ldflags prints the linker flags that strip the binary and embed the build information.
go_ldflags() {
  local buildtime git_hash git_dirty
  buildtime=$(TZ=UTC date -u '+%Y-%m-%dT%H:%M:%SZ')
  # Sources without git (a tarball, a shallow export): the commit is unknown, not an error.
  if command -v git >/dev/null && git rev-parse --git-dir >/dev/null 2>&1; then
    git_hash="$(git rev-parse HEAD)"
    git_dirty="$(test -n "$(git status --porcelain)" && echo "+CHANGES" || true)"
  else
    git_hash="unknown"
    git_dirty=""
  fi
  echo "-s -w \
-X ${MODULE}/internal/buildinfo.Version=${APP_VERSION} \
-X ${MODULE}/internal/buildinfo.BuildTime=${buildtime} \
-X ${MODULE}/internal/buildinfo.GitCommit=${git_hash}${git_dirty}"
}
